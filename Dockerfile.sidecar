# syntax=docker/dockerfile:1

# The Python sidecar (sidecar/): a FastAPI server the Go server talks to over HTTP.
FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY sidecar/requirements_sidecar.txt ./
RUN pip install --no-cache-dir -r requirements_sidecar.txt
COPY sidecar/main_sidecar.py sidecar/sidecar_config.py sidecar/routes.py ./
COPY sidecar/backends ./backends
# The code the "deploy" action uploads to Modal (backends/modal_backend.py runs `python -m providers.modal.deploy` from here).
COPY sidecar/ai_train ./ai_train
RUN useradd --uid 10002 --no-create-home sidecar
USER sidecar
# Inside a container it must listen on all interfaces to be reachable through the published port.
ENV SIDECAR_HOST=0.0.0.0 SIDECAR_PORT=8787
EXPOSE 8787
CMD ["python", "main_sidecar.py"]
